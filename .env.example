DISCORD_TOKEN=your_bot_token_here
# Optional: channel where lineup and transaction polling updates are posted.
# Separate multiple channel IDs with commas to post to several channels.
# Example: DISCORD_CHANNEL_ID=123456789012345678,987654321098765432
DISCORD_CHANNEL_ID=
# Optional: post to a channel in a server where you cannot install the bot.
# A server admin creates this under Server Settings > Integrations > Webhooks.
# Separate multiple webhook URLs with commas. Treat these like passwords.
# Example: DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/<id>/<token>
DISCORD_WEBHOOK_URL=
# Polling adapts to the schedule. POLL_INTERVAL_SECONDS is the idle baseline,
# used when no game is near. Postponed and cancelled games count as idle.
POLL_INTERVAL_SECONDS=300
# Used while a game is underway, including during a rain delay.
LIVE_POLL_INTERVAL_SECONDS=60
# Used in the run up to first pitch, when the lineup card is posted.
PREGAME_POLL_INTERVAL_SECONDS=120
# How long before first pitch the pre-game interval starts. Lineups usually
# drop around three hours out.
PREGAME_LEAD_MINUTES=240
MATCHUP_MIN_PA=5
TIME_ZONE=America/New_York
